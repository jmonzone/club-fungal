  playerReference: {fileID: 11400000, guid: 746148e8242954418b04a3ab83ac9260, type: 2}
  dialogueReference: {fileID: 11400000, guid: 66db6a8c7a0524bd8b89b88de939507f, type: 2}
  workTogetherDialogue:
  - unit: {fileID: 0}
    text: 'WAHT? you didn''t mean to come to my party?

      but i threw it 4 u!
      i''m just kidding, so...'
    responses: []
    type: 0
    action: 0
    element: 
  - unit: {fileID: 0}
    text: you're lost? join the club. no literally. join my club :) i'm trying to
      build a reputation
    responses: []
    type: 0
    action: 0
    element: 
  - unit: {fileID: 0}
    text: you may be lost today so party along the way
    responses: []
    type: 0
    action: 0
    element: 
  - unit: {fileID: 0}
    text: do you wanna help out?
    responses: []
    type: 0
    action: 0
    element: 
  - unit: {fileID: 0}
    text: yay! ok we're going to need to more plants. when we party, so do the plants.
    responses: []
    type: 0
    action: 0
    element: 
  - unit: {fileID: 0}
    text: they emit spores and spores are EVERYTHING. here take this, it's yours,
      why don't you go plant this somewhere
    responses: []
    type: 0
    action: 4
    element: 
  buildCompleteDialogue:
  - unit: {fileID: 0}
    text: sweet! now its a party. alright i have my friends on the ready. let me
      know when you're ready.
    responses: []
    type: 0
    action: 0
    element: 
